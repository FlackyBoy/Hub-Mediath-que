# Copier ce fichier en .env et remplir les valeurs. Ne jamais versionner .env.

# --- Général ---
TZ=Europe/Paris
# UID/GID de l'utilisateur propriétaire des fichiers (commande : id viou)
PUID=1000
PGID=1000

# --- App ---
# Port local (joignable uniquement via tailscale serve)
APP_PORT=3100
# URL publique Tailscale, ex. https://ns320818.tailXXXX.ts.net
APP_URL=

# --- Authentification (un seul compte) ---
AUTH_USERNAME=viou
# Hash scrypt du mot de passe : cd app; npm run hash-password -- "ton mot de passe"
AUTH_PASSWORD_HASH=
# Chaîne aléatoire de 64 caractères : openssl rand -hex 32
SESSION_SECRET=

# --- Fichiers ---
# Dossier racine monté dans l'app (même chemin dedans et dehors)
MEDIA_ROOT=/home/viou
# Sous-dossiers visibles dans l'explorateur (séparés par des virgules)
MEDIA_DIRS=download,films

# --- rTorrent (existant) ---
RTORRENT_SCGI_HOST=127.0.0.1
RTORRENT_SCGI_PORT=41758
# Dossier de destination par catégorie
DOWNLOAD_DIR_FILMS=/home/viou/download/films
DOWNLOAD_DIR_SERIES=/home/viou/download/series
DOWNLOAD_DIR_AUTRES=/home/viou/download

# --- Prowlarr ---
PROWLARR_URL=http://127.0.0.1:9696
# Settings > General > API Key dans Prowlarr
PROWLARR_API_KEY=

# --- Plex (existant) : bash deploy/set-plex-token.sh ---
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=

# --- Films et séries : clé TMDB (themoviedb.org) : bash deploy/set-tmdb-key.sh ---
TMDB_API_KEY=

# --- Jeux de société : jeton BoardGameGeek : bash deploy/set-bgg-token.sh ---
BGG_API_TOKEN=

# --- Notifications Web Push : cd app; npm run vapid ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:moi@example.com

# --- Bibliothèque (optionnel) ---
# Clé Google Books : source de secours pour les couvertures (Open Library suffit en général)
GOOGLE_BOOKS_API_KEY=

# --- Chatbot (optionnel) : bash deploy/set-anthropic-key.sh ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high : plus haut = réponses plus réfléchies mais plus chères
ANTHROPIC_EFFORT=medium
